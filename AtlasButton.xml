<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
	<Button name="AtlasButton" parent="Minimap" enableMouse="true">
		<Size x="33" y="33"/>
		<Anchors>
			<Anchor point="TOPLEFT" relativeTo="Minimap" relativePoint="RIGHT"><Offset x="2" y="0"/></Anchor>
		</Anchors>
		<HighlightTexture alphaMode="ADD" file="Interface\Minimap\UI-Minimap-ZoomButton-Highlight"/>
		<Layers>
			<Layer level="BORDER">
				<Texture name="$parentIcon" file="Interface\WorldMap\WorldMap-Icon">
					<Size x="20" y="20"/>
					<Anchors>
						<Anchor point="CENTER"><Offset x="-2" y="1"/></Anchor>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<Texture name="$parentBorder" file="Interface\Minimap\MiniMap-TrackingBorder">
					<Size x="52" y="52"/>
					<Anchors>
						<Anchor point="TOPLEFT"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad>
				this:RegisterEvent("VARIABLES_LOADED");
				this:RegisterForDrag("RightButton");
				this:SetFrameLevel(Minimap:GetFrameLevel() + 3)
				this.dragme = false;
			</OnLoad>
			<OnDragStart> 
				this.dragme = true;
			</OnDragStart> 
			<OnDragStop>
				this.dragme = false;
			</OnDragStop>
			<OnUpdate>
				if this.dragme then
					AtlasButton_BeingDragged();
				end
			</OnUpdate>
			<OnClick>
				AtlasButton_OnClick();
			</OnClick>
			<OnEnter>
				AtlasButton_OnEnter();
			</OnEnter>
			<OnLeave>
				GameTooltip:Hide();
			</OnLeave>
			<OnEvent>
				AtlasButton_Init();
				AtlasButton_UpdatePosition();
			</OnEvent>
		</Scripts>
	</Button>
</Ui>
